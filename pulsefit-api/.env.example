# Copy to .env and fill in. Never commit .env.
# See docs/backend-spec.md §3.

# Supabase project URL; issuer and JWKS are derived from it
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres via the Supabase session pooler (role pulsefit_api)
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres
DB_USER=pulsefit_api.<project-ref>
DB_PASSWORD=

# Secret key for Supabase Auth Admin calls (server only)
SUPABASE_SERVICE_KEY=
